{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-card-api-data",
  "main": "worker.js",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "frontend"
  },
  "vars": {
    // Scraping order: if SCRAPER_URL is set, the Worker delegates the eBay fetch
    // to that external service (deploy scraper-service/ on a free host whose IP
    // eBay does not block, e.g. Render). Otherwise it fetches in-Worker, where
    // CF_WORKER_URL is a fallback proxy route. Set after deploying the service:
    //   wrangler secret put SCRAPER_URL      (or add as a plaintext var)
    //   wrangler secret put SCRAPER_SECRET   (optional, must match the service)
    // For residential proxying instead, set SCRAPER_API_KEY (+ SCRAPER_API_PREMIUM).
    "CF_WORKER_URL": "https://ebay-proxy-gridironcards.thecardhuddleoffical.workers.dev"
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gridironcards",
      "database_id": "23d5a4a9-006b-4856-b160-63862aa8a9c5",
      "migrations_dir": "migrations"
    }
  ]
}
