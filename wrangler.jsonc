{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-card-api-data",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "frontend"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gridironcards",
      "database_id": "23d5a4a9-006b-4856-b160-63862aa8a9c5"
    }
  ]
}
