{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-card-api-data",
  "main": "worker.js",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "frontend"
  },
  "vars": {
    // eBay fetching now happens inside this Worker. CF_WORKER_URL is the
    // deployed eBay-proxy Worker used as a fallback route. For reliable
    // (residential) fetches, set the SCRAPER_API_KEY secret:
    //   wrangler secret put SCRAPER_API_KEY
    // and optionally the SCRAPER_API_PREMIUM / SCRAPER_API_COUNTRY vars.
    "CF_WORKER_URL": "https://ebay-proxy-gridironcards.thecardhuddleoffical.workers.dev"
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gridironcards",
      "database_id": "23d5a4a9-006b-4856-b160-63862aa8a9c5",
      "migrations_dir": "migrations"
    }
  ]
}
